  "item": [
    {
      "name": "Get_UserSearch_TC_01",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();\r",
              "\r",
              "pm.test(\"Tc_01_Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"TC_02_Response must be in JSON format\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"TC_03_Response must contain id, name, username, email, and address\", function () {\r",
              "    pm.expect(pm.response.json()).to.have.property('id');\r",
              "    pm.expect(pm.response.json()).to.have.property('name');\r",
              "    pm.expect(pm.response.json()).to.have.property('username');\r",
              "    pm.expect(pm.response.json()).to.have.property('email');\r",
              "    pm.expect(pm.response.json()).to.have.property('address');\r",
              "});\r",
              "\r",
              "pm.test(\"TC_04_Returned User ID must match the requested User ID\", function () {\r",
              "pm.expect(data.id).to.eql(3);\r",
              "});\r",
              "\r",
              "pm.test(\"TC_05_Email must have a valid basic format\", function () {\r",
              "     pm.expect(data.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"TC_06_Response time must be below 2000 ms for this exercise\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "    \r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
