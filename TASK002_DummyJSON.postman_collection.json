  "item": [
    {
      "name": "TC_01_Valid_Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();\r",
              "\r",
              "pm.test(\"TC_01_Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"TC_02_Response time is less than 2000ms\", function () {\r",
              "        pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "    });\r",
              "\r",
              "\r",
              "pm.test(\"TC_03_Access Token exists\", function(){\r",
              "    pm.expect(data).to.have.property(\"accessToken\")\r",
              "});\r",
              "\r",
              "pm.test(\"TC_04_User ID is returned\", function () {\r",
              "    pm.expect(data).to.have.property(\"id\");\r",
              "    pm.expect(data.id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"TC_05_Username is returned\", function () {\r",
              "    pm.expect(data).to.have.property(\"username\")\r",
              "});\r",
              "pm.test(\"TC_06_Access token is not empty\", function () {\r",
              "    pm.expect(data.accessToken).to.be.a(\"string\");\r",
              "    pm.expect(data.accessToken).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"TC_07_User email is returned\", function () {\r",
              "    pm.expect(data).to.have.property(\"email\");\r",
              "});\r",
              "\r",
              "pm.test(\"TC_08_Refresh Token exists\", function(){\r",
              "    pm.expect(data).to.have.property(\"refreshToken\")\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"username\": \"emilys\",\r\n  \"password\": \"emilyspass\",\r\n  \"expiresInMins\": 30\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://dummyjson.com/auth/login",
